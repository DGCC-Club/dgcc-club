---
import * as cheerio from 'cheerio';

let cleanText = (str: string | null) => (str == null)
    ? str
    : str.replaceAll("\n", "").trim().replaceAll("\t", "");

const scoreBoard = await fetch("https://www.ratatype.com/groups/5375404/en_new/")
    .then(response => response.text());

let dictionary: any[] = [];
const $ = cheerio.load(scoreBoard);
$('.js-member-row > .flex').each((i, elem) => {
    const element = $(elem);
    // Remove the second child if it exists
    if (element.children().length > 1) {
        element.children().eq(1).remove();
    }
    dictionary.push({
        id: cleanText(element.children().eq(0).text()),
        name: cleanText(element.children().eq(1).text()),
        typingSpeed: cleanText(element.children().eq(2).children().eq(0).text()),
        percentage: cleanText(element.children().eq(2).children().eq(1).text()),
    });
});
---

<section class="py-20 min-h-full h-screen bg-gray-900/80 backdrop-blur-sm text-white">
    <div class="rounded-lg shadow-lg overflow-hidden">
        <div class="p-6">
            <div class="mb-6">
                <label for="search" class="sr-only">Search by name</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                             fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd"
                                  d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
                                  clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <input
                            id="search"
                            name="search"
                            class="block w-full pl-10 pr-3 py-2 border border-gray-600 rounded-md leading-5 bg-gray-700 text-gray-300 placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                            placeholder="Search by name"
                            type="search"
                    />
                </div>
            </div>

            <div class="overflow-x-auto rounded-xl">
                <table class="min-w-full divide-y divide-gray-600" id="leaderboard-table">
                    <thead class="bg-gray-700">
                    <tr>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                            ID
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">
                            Name
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider cursor-pointer"
                            id="sort-accuracy">
                            <div class="flex items-center">
                                Accuracy (%)
                                <svg class="ml-1 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M10 3a1 1 0 01.707.293l3 3a1 1 0 01-1.414 1.414L10 5.414 7.707 7.707a1 1 0 01-1.414-1.414l3-3A1 1 0 0110 3zm-3.707 9.293a1 1 0 011.414 0L10 14.586l2.293-2.293a1 1 0 011.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
                                          clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider cursor-pointer"
                            id="sort-speed">
                            <div class="flex items-center">
                                Typing Speed
                                <svg class="ml-1 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M10 3a1 1 0 01.707.293l3 3a1 1 0 01-1.414 1.414L10 5.414 7.707 7.707a1 1 0 01-1.414-1.414l3-3A1 1 0 0110 3zm-3.707 9.293a1 1 0 011.414 0L10 14.586l2.293-2.293a1 1 0 011.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
                                          clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </th>
                    </tr>
                    </thead>
                    <tbody class="bg-gray-800 divide-y divide-gray-600 opacity-95" id="leaderboard-body">
                    {dictionary.map((entry) => (
                            <tr class="hover:bg-gray-700 transition-colors duration-150"
                                data-name={entry.name.toLowerCase()} data-accuracy={entry.accuracy}
                                data-speed={parseFloat(entry.typingSpeed)}>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                    {entry.id}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10">
                                            <img class="h-10 w-10 rounded-full border border-gray-600"
                                                 src={entry.image || "/dgcc-club/favicon.svg"} alt={entry.name}/>
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-white">{entry.name}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                    {entry.percentage}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                    {entry.typingSpeed}
                                </td>
                            </tr>
                    ))}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script is:raw>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('search');
            const sortAccuracyBtn = document.getElementById('sort-accuracy');
            const sortSpeedBtn = document.getElementById('sort-speed');
            const tableBody = document.getElementById('leaderboard-body');
            const rows = Array.from(tableBody.querySelectorAll('tr'));

            // Variables to track sorting state
            let accuracySortDirection = 'desc'; // Start with highest accuracy first
            let speedSortDirection = 'desc'; // Start with fastest speed first

            // Function to filter rows based on search input
            function filterRows() {
                const searchTerm = searchInput.value.toLowerCase().trim();

                rows.forEach(row => {
                    const name = row.getAttribute('data-name');
                    const isVisible = name.includes(searchTerm);
                    row.style.display = isVisible ? '' : 'none';
                });
            }

            // Function to sort rows by accuracy
            function sortByAccuracy() {
                const sortedRows = rows.sort((a, b) => {
                    const aValue = parseFloat(a.getAttribute('data-accuracy'));
                    const bValue = parseFloat(b.getAttribute('data-accuracy'));

                    return accuracySortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                });

                // Toggle sort direction for next click
                accuracySortDirection = accuracySortDirection === 'asc' ? 'desc' : 'asc';

                // Update UI to show sort direction
                updateSortIcon(sortAccuracyBtn, accuracySortDirection);

                // Clear and re-append rows in new order
                sortedRows.forEach(row => tableBody.appendChild(row));
            }

            // Function to sort rows by typing speed
            function sortBySpeed() {
                const sortedRows = rows.sort((a, b) => {
                    const aValue = parseFloat(a.getAttribute('data-speed'));
                    const bValue = parseFloat(b.getAttribute('data-speed'));

                    return speedSortDirection === 'asc' ? aValue - bValue : bValue - aValue;
                });

                // Toggle sort direction for next click
                speedSortDirection = speedSortDirection === 'asc' ? 'desc' : 'asc';

                // Update UI to show sort direction
                updateSortIcon(sortSpeedBtn, speedSortDirection);

                // Clear and re-append rows in new order
                sortedRows.forEach(row => tableBody.appendChild(row));
            }

            // Function to update sort icon
            function updateSortIcon(button, direction) {
                const icon = button.querySelector('svg');
                if (direction === 'asc') {
                    icon.innerHTML = '<path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"></path>';
                } else {
                    icon.innerHTML = '<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>';
                }
            }

            // Add event listeners
            if (searchInput) {
                searchInput.addEventListener('input', filterRows);
            }

            if (sortAccuracyBtn) {
                sortAccuracyBtn.addEventListener('click', sortByAccuracy);
            }

            if (sortSpeedBtn) {
                sortSpeedBtn.addEventListener('click', sortBySpeed);
            }

            // Initial sort by accuracy (highest first)
            sortByAccuracy();
        });
    </script>

    <style>
        /* Add custom styles for the table */
        table {
            border-collapse: separate;
            border-spacing: 0;
        }

        th {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        /* Ensure the hover effect works well */
        tr.hover\:bg-gray-700:hover {
            background-color: rgba(55, 65, 81, 0.8);
        }

        /* Responsive table styles */
        @media (max-width: 640px) {
            table {
                display: block;
                overflow-x: auto;
            }
        }
    </style>
</section>
