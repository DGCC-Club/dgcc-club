---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Base title={post.data.title}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <article class="bg-gray-800 rounded-lg overflow-hidden shadow-xl">
      <div class="p-8">
        <header class="mb-8">
          <div class="text-amber-400 text-sm mb-2">
            {post.data.date.toLocaleDateString('en-US', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
            {post.data.author && ` • By ${post.data.author}`}
          </div>
          <h1 class="text-3xl md:text-4xl font-bold mb-4 text-white">{post.data.title}</h1>
          {post.data.description && (
            <p class="text-xl text-gray-300 italic">{post.data.description}</p>
          )}
        </header>
        
        <div class="prose prose-invert prose-lg max-w-none text-white">
          <Content />
        </div>
        
        <footer class="mt-12 pt-6 border-t border-gray-700">
          <a 
            href="/blog" 
            class="inline-flex items-center text-amber-400 hover:text-amber-300 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Blog
          </a>
        </footer>
      </div>
    </article>
  </div>
</Base>

<style>
  /* Ensure all text in the blog post is white */
  .prose {
    color: white;
  }
  
  /* Style links in the blog post */
  .prose a {
    color: #fbbf24; /* amber-400 */
    text-decoration: underline;
  }
  
  .prose a:hover {
    color: #fcd34d; /* amber-300 */
  }
  
  /* Style headings in the blog post */
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: white;
  }
  
  /* Style code blocks in the blog post */
  .prose pre, .prose code {
    background-color: #1f2937; /* gray-800 */
    color: #e5e7eb; /* gray-200 */
  }
</style> 